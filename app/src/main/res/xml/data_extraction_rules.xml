<?xml version="1.0" encoding="utf-8"?>
<!-- API 키가 들어 있는 설정을 백업이나 기기 이전으로 내보내지 않는다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
